{
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    ":semanticCommitScopeDisabled",
    ":semanticPrefixChore",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:githubActionsVersions",
  ],
  customManagers: [{
      "customType": "regex",
      "managerFilePatterns": ["**/versions.yaml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))(?: versioning=(?<versioning>.*\\S+?))?\\s+- [\"']?(?<currentValue>.+?)[\"']?\\s",
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#unless (equals depName packageName)}} packageName={{{packageName}}}{{/unless}}\n- '{{{newValue}}}'\n- '{{{currentValue}}}'\n",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}",
  }],
  packageRules: [
    {
      "matchFileNames": ["**/versions.yaml"],
      "automerge": true,
      "commitMessageAction": "add",
      "commitMessageExtra": "{{prettyNewVersion}}",
      "commitMessageTopic": "`{{depName}}` version",
      "extends": [
        ":semanticCommitScopeDisabled",
        ":semanticCommitType(update)",
      ],
    },
  ]
}