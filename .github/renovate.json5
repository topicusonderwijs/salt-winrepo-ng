{
  extends: [
    "local>topicusonderwijs/renovate-config:default.json5"
  ],
  customManagers: [{
      "customType": "regex",
      "managerFilePatterns": ["**/versions.yaml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))(?: versioning=(?<versioning>.*?))?\\s+- [\"']?(?<currentValue>.+?)[\"']?\\s",
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#unless (equals depName packageName)}} packageName={{{packageName}}}{{/unless}}\n- '{{{newValue}}}'\n- '{{{currentValue}}}'\n",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
  }],
  packageRules: [
    {
      "matchFileNames": ["**/versions.yaml"],
      "automerge": true,
      "commitMessageAction": "add",
      "commitMessageExtra": "{{prettyNewVersion}}",
      "commitMessageTopic": "`{{depName}}` version",
      "extends": [
        ":semanticCommitScopeDisabled",
        ":semanticCommitType(update)",
      ],
    },
  ]
}